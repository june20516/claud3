{
  "name": "claud3",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Agent SDK 기반 개인용 터미널 코딩 CLI",
  "type": "module",
  "bin": {
    "claud3": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "promote": "bash scripts/promote.sh",
    "rollback": "bash scripts/rollback.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "diff": "^9.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
